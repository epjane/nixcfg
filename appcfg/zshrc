        firefox --new-window "$1" &
    else
        xdg-open $@ &
    fi
}

f(){
    fm=nautilus
    #fm=nemo
    #fm=dolphin
    if [[ $# == 0 ]]; then
        $fm . &
    else
        $fm $@ &
    fi
}

co(){
    co=codium
    if [[ $# == 0 ]]
    then
        $co .
    else
        if [[ ! -d "$1" ]] && [[ ! -f "$1" ]]; then
            mkdir "$1" && \
            cd "$1" && \
            git init && \
            my-git-remotes && \
            mit && \
            touch README.md && \
            cd -
        fi
        $co $@
    fi
}

my-git-clone(){
    url="$1"
    repo="$(basename -s .git "$url")"
    username="$(basename "$(dirname "$url")")"
    mkdir -p "$HOME/git/$username"
    cd "$HOME/git/$username"
    git clone "$url"
    cd "$repo"
}

