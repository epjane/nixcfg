# Double ESC: prepend/remove sudo
sudo-command-line() {
  [[ -z $BUFFER ]] && zle up-history

  if [[ $BUFFER == sudo\ * ]]; then
    BUFFER="${BUFFER#sudo }"
  else
    BUFFER="sudo $BUFFER"
  fi

  zle end-of-line
}

zle -N sudo-command-line

bindkey -M emacs '\e\e' sudo-command-line
bindkey -M viins '\e\e' sudo-command-line
bindkey -M vicmd '\e\e' sudo-command-line

