# Functions
unalias l
l(){
    cols=`tput cols`
    if [[ $# -eq 0 ]]; then
	      l .
    fi
    while [[ $# -gt 0 ]]; do
        if [[ -f "$1" ]]; then
            type=`file "$1" | cut -f2 -d: | sed 's/^ //'`
            if echo "$type" | grep 'ASCII text' > /dev/null; then
              cat "$1"
              [ "$(tail -c1 "$1"; echo x)" != $'\nx' ] && echo -e "\e[1;7m%\e[0m"
              printf '=%.0s' {1..$cols}; echo
            fi
            echo -e '\033[92m'"$type"'\033[0m'
        else
            ls -lAh "$1"
        fi
        printf '-%.0s' {1..$cols}; echo
        ls -lAh -d "$1"
        shift
        if [[ $# -gt 0 ]]; then
          echo
          printf '=%.0s' {1..$cols}; echo
        fi
    done
}

