function my_git_prompt_info() {
  local ref
  local git_status=""
  local short_sha

  ref=$(git symbolic-ref --quiet HEAD 2>/dev/null) || return

  ref="${ref#refs/heads/}"
  short_sha=$(git rev-parse --short HEAD 2>/dev/null)

  # Untracked
  [[ -n $(git ls-files --others --exclude-standard 2>/dev/null) ]] && git_status+="%%"

  # Added
  [[ -n $(git diff --cached --name-only --diff-filter=A 2>/dev/null) ]] && git_status+="+"

  # Modified
  [[ -n $(git diff --name-only 2>/dev/null) ||
     -n $(git diff --cached --name-only --diff-filter=M 2>/dev/null) ]] &&
    git_status+="*"

  # Renamed
  [[ -n $(git diff --cached --name-only --diff-filter=R 2>/dev/null) ]] && git_status+="~"

  # Deleted
  [[ -n $(git diff --name-only --diff-filter=D 2>/dev/null) ||
     -n $(git diff --cached --name-only --diff-filter=D 2>/dev/null) ]] &&
    git_status+="!"

  # Unmerged
  [[ -n $(git diff --name-only --diff-filter=U 2>/dev/null) ]] && git_status+="?"

  [[ -n "$git_status" ]] && git_status=" $git_status"

  echo "%F{yellow}[${ref} ${short_sha}${git_status}]%f "
}

